flowchart TB

  v_call["Call completeBuffer on the <br/>CameraManager thread <br/>(caller obligation)"]
  v_all{"Have all buffers completed?"}
  v_false["false: buffers remain"]
  v_true["true: last buffer <br/>completed, request not <br/>automatically completed"]
  v_explicit["Handler explicitly calls <br/>completeRequest()"]
  v_stop["Pipeline handler is stopped <br/>with stop()"]
  v_stop_track["Queued requests <br/>auto-completed by request <br/>tracking (separate <br/>contract, no order defined <br/>against buffer flow)"]
  v_stop_signal["Completion is signalled via <br/>completeRequest()"]
  v_call -->|"After notifying buffer <br/>completion and updating <br/>internal buffer tracking"| v_all
  v_all -->|"No (false)"| v_false
  v_all -->|"Yes (true)"| v_true
  v_true -->|"After the chance for <br/>still-needed work, explicit <br/>completion"| v_explicit
  v_stop -->|"Applies to tracked requests <br/>when stop() is called"| v_stop_track
  v_stop_track -->|"Completion signalling method"| v_stop_signal
