  v_methods["Lsc init and configure use <br/>the same grid cell counts."]
  v_sensor["init reads the width and <br/>height of the sensor active <br/>area."]
  v_minimum["Ceiling-divide the active <br/>width by 73 and the active <br/>height by 56."]
  v_grid["Round cell sizes up to <br/>powers of two, then compute <br/>the cell count on each axis."]
  v_init["Pass the cell counts to the <br/>common init and return its <br/>result."]
  v_crop["configure first stores the <br/>width and height of <br/>analogCrop."]
  v_x["Compute xPos using the <br/>horizontal cell count. Each <br/>position is i divided by <br/>#40;the cell count minus one#41;."]
  v_y["Then compute yPos the same <br/>way using the vertical cell <br/>count."]
  v_formula-limit["A cell count of 0 skips the <br/>loop. A count of 1 gives a <br/>zero denominator."]
  v_configure["Pass active state, <br/>analogCrop, xPos and yPos <br/>to the common configure and <br/>return its result."]
