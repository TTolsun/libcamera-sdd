flowchart TB

  v_disconnect{"Both overloads check the <br/>common disconnection <br/>condition."}
  v_nodev["If the condition is true, <br/>both overloads return <br/>-ENODEV."]
  v_exact{"The single-state overload <br/>checks whether currentState <br/>matches state."}
  v_range{"The range overload checks <br/>whether currentState is <br/>between low and high, <br/>inclusive."}
  v_exact_ok["If the states match, it <br/>returns 0."]
  v_range_ok["If the state is within the <br/>range, it returns 0."]
  v_exact_assert["If the states do not match, <br/>ASSERT checks state."]
  v_range_assert["If the state is outside the <br/>range, ASSERT checks low <br/>and high."]
  v_exact_error["If valid state passes <br/>ASSERT, it logs an error <br/>and returns -EACCES."]
  v_range_error["If valid low and high pass <br/>ASSERT, it logs an error <br/>and returns -EACCES."]
  v_disconnect -->|"If true, it returns the <br/>disconnection error. #91;true#93;"| v_nodev
  v_disconnect -->|"If false, the single-state <br/>contract checks the state. <br/>#91;false#93;"| v_exact
  v_disconnect -->|"If false, the range <br/>contract checks the state. <br/>#91;false#93;"| v_range
  v_exact -->|"If the match condition is <br/>true, it returns success. <br/>#91;true#93;"| v_exact_ok
  v_exact -->|"If the match condition is <br/>false, it checks state. <br/>#91;false#93;"| v_exact_assert
  v_range -->|"If the range condition is <br/>true, it returns success. <br/>#91;true#93;"| v_range_ok
  v_range -->|"If the range condition is <br/>false, it checks low and <br/>high. #91;false#93;"| v_range_assert
  v_exact_assert -->|"If valid state passes <br/>ASSERT, it returns an error."| v_exact_error
  v_range_assert -->|"If valid low and high pass <br/>ASSERT, it returns an error."| v_range_error
