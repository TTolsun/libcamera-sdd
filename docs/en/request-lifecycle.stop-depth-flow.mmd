  v_stop["PipelineHandlerUVC::<br/>stopDevice calls streamOff."]
  v_entry{"streamOff checks the <br/>streaming state and queued <br/>buffers."}
  v_ioctl{"streamOff stops watchdog#95; <br/>if needed and calls <br/>VIDIOC#95;STREAMOFF."}
  v_failure["If ioctl returns a negative <br/>value, streamOff logs the <br/>error and returns ret."]
  v_loop["It sets State::Stopping, <br/>then puts each queued <br/>buffer in cache#95;, cancels <br/>it, and emits bufferReady."]
  v_cleanup["If ASSERT passes, it clears <br/>the queue, disables the <br/>notifier, sets <br/>State::Stopped, and returns <br/>0."]
  v_returned["The three paths meet only <br/>when streamOff actually <br/>returns; ASSERT failure or <br/>abnormal callback <br/>termination does not <br/>guarantee a return."]
  v_release["releaseBuffers returns 0 <br/>without cache#95;; otherwise <br/>it resets cache#95; and <br/>returns the result of <br/>requestBuffers, which may <br/>fail."]
