flowchart TB

  v_pipeline["PipelineHandler.<br/>cancelRequest starts <br/>cancelling the request."]
  v_cancel_entry["Request::Private::cancel is <br/>entered."]
  v_assert["If active ASSERT fails, it <br/>logs a Fatal error and <br/>aborts. If NDEBUG is <br/>defined before including <br/>log.h, ASSERT generates no <br/>code."]
  v_helper["doCancelRequest cancels <br/>each pending buffer and <br/>directly emits <br/>bufferCompleted, then sets <br/>cancelled#95; and clears <br/>pending#95;, notifiers#95; and <br/>timer#95;."]
  v_cancel_return["When doCancelRequest <br/>returns normally, cancel <br/>returns normally. Calling <br/>doCancelRequest alone does <br/>not guarantee request <br/>completion in other <br/>contexts."]
  v_complete["cancelRequest calls <br/>completeRequest."]
  v_pipeline -->|"cancelRequest calls cancel."| v_cancel_entry
  v_cancel_entry -->|"cancel checks the <br/>RequestPending status with <br/>ASSERT."| v_assert
  v_assert -->|"If ASSERT passes or its <br/>code is removed and <br/>execution continues, cancel <br/>calls doCancelRequest."| v_helper
  v_helper -->|"When doCancelRequest <br/>returns normally, cancel <br/>returns."| v_cancel_return
  v_cancel_return -->|"When cancel returns <br/>normally, cancelRequest <br/>calls completeRequest."| v_complete
