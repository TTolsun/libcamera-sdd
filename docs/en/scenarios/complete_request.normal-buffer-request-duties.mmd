  v_handler["PipelineHandler is <br/>responsible for signaling <br/>buffer and request <br/>completion."]
  v_complete_buffer["Call completeBuffer on the <br/>CameraManager thread; it <br/>notifies the app and <br/>updates buffer tracking."]
  v_buffer_result["completeBuffer returns true <br/>if all buffers in the <br/>request are complete, and <br/>false otherwise."]
  v_complete_request["The last buffer does not <br/>complete the request; the <br/>handler must explicitly <br/>call completeRequest after <br/>any needed work."]
  v_request["Call the completion <br/>function on the <br/>CameraManager thread; the <br/>handler must not access the <br/>request after it returns."]
  v_application["Requests return to the <br/>application in submission <br/>order; the handler may <br/>report completed requests <br/>in any order."]
  v_private_complete["Request::Private::complete <br/>asserts that the request is <br/>RequestPending and has no <br/>pending buffers."]
  v_assert["ASSERT logs a Fatal error <br/>and aborts if false; <br/>passing or compiling it out <br/>with NDEBUG does not abort."]
