flowchart TB

  v_available["The camera is Available. <br/>Release it when finished."]
  v_acquired["The camera is Acquired. <br/>Acquire and configure it to <br/>prepare for capture."]
  v_configured["The camera is Configured. <br/>It can be reconfigured or <br/>started and stopped <br/>repeatedly until released."]
  v_running["The camera is Running and <br/>can process requests until <br/>stopped."]
  v_stopping["The camera is Stopping. The <br/>caller must synchronize <br/>state functions if <br/>necessary."]
  v_available -->|"release#40;#41; leaves the camera <br/>Available."| v_available
  v_available -->|"acquire#40;#41; moves the camera <br/>to Acquired."| v_acquired
  v_acquired -->|"release#40;#41; moves the camera <br/>to Available."| v_available
  v_acquired -->|"configure#40;#41; moves the <br/>camera to Configured."| v_configured
  v_configured -->|"release#40;#41; moves the camera <br/>to Available."| v_available
  v_configured -->|"configure#40;#41; or <br/>createRequest#40;#41; leaves the <br/>camera Configured."| v_configured
  v_configured -->|"start#40;#41; moves the camera to <br/>Running."| v_running
  v_running -->|"stop#40;#41; moves the camera to <br/>Stopping."| v_stopping
  v_stopping -->|"The camera transitions from <br/>Stopping to Configured."| v_configured
  v_running -->|"createRequest#40;#41; or <br/>queueRequest#40;#41; leaves the <br/>camera Running."| v_running
