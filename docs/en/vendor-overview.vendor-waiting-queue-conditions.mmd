  v_queue["queueRequest: push request <br/>to waitingRequests_"]
  v_prepare["Start preparation by <br/>calling prepare(300ms)"]
  v_reg["registerRequest: connect <br/>callback to prepared signal"]
  v_cb["Prepared callback invokes <br/>doQueueRequests(camera)"]
  v_waiting{"Does waitingRequests_ <br/>contain an item?"}
  v_limit{"Is queuedRequests_ size <br/>equal to <br/>maxQueuedRequestsDevice_?"}
  v_front["Inspect the front request <br/>of waitingRequests_"]
  v_ready{"Is the front request <br/>prepared_?"}
  v_pop["Pop waitingRequests_ first"]
  v_fwd["Call doQueueRequest(request)"]
  v_end["End this invocation&#x27;s <br/>forwarding loop"]
  v_queue -->|"Start preparation after push"| v_prepare
  v_reg -->|"Callback runs when the <br/>prepared signal is <br/>delivered (conditional)"| v_cb
  v_cb -->|"Enter doQueueRequests"| v_waiting
  v_waiting -->|"Yes"| v_limit
  v_waiting -->|"No"| v_end
  v_limit -->|"Yes: break"| v_end
  v_limit -->|"No: inspect front"| v_front
  v_front -->|"Check the front request"| v_ready
  v_ready -->|"No: break"| v_end
  v_ready -->|"Yes"| v_pop
  v_pop -->|"Then call doQueueRequest"| v_fwd
  v_fwd -->|"Recheck loop condition"| v_waiting
