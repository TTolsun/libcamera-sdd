  v_start_check{"Check the camera start <br/>result."}
  v_start_fail["Stop the sink if present <br/>and return the start error."]
  v_remaining{"Check whether initial <br/>requests remain."}
  v_limit_check{"Check whether queue API <br/>call attempts reached the <br/>configured limit."}
  v_control_merge["Merge controls only with a <br/>script; always increment <br/>queue API call attempts."]
  v_camera_queue_check{"Check the running state and <br/>the request#39;s camera, <br/>status, controls, buffers <br/>and runs."}
  v_queue_error["If a check fails, the API <br/>returns a negative error."]
  v_queue_async["Queue the pipeline call <br/>asynchronously and return 0 <br/>from the API."]
  v_caller_check{"The caller checks whether <br/>the helper#39;s return value <br/>is negative."}
  v_stop_on_error["Stop the camera and any <br/>sink, then return the error."]
  v_done["After the loop, print the <br/>capture notice for the <br/>limit and return 0."]
