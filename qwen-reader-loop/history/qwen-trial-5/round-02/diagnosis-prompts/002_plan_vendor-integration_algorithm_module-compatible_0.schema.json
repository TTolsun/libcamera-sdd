{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "checks",
    "findings",
    "clarification",
    "expand"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "acceptable",
        "repair",
        "insufficient_evidence"
      ]
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "conditions",
        "modality",
        "returns",
        "ordering",
        "coverage"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "not_applicable"
          ]
        },
        "conditions": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "not_applicable"
          ]
        },
        "modality": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "not_applicable"
          ]
        },
        "returns": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "not_applicable"
          ]
        },
        "ordering": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "not_applicable"
          ]
        },
        "coverage": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "not_applicable"
          ]
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "candidate",
          "issue"
        ],
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "subject",
              "conditions",
              "modality",
              "returns",
              "ordering",
              "coverage"
            ]
          },
          "candidate": {
            "type": "string",
            "enum": [
              "module-compatible:current"
            ]
          },
          "issue": {
            "type": "string"
          }
        }
      }
    },
    "clarification": {
      "type": "string",
      "maxLength": 1600
    },
    "expand": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "module-compatible:current"
        ]
      }
    }
  }
}
