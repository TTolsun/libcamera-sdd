{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "statements"
  ],
  "properties": {
    "statements": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "quote_id",
          "covers",
          "kind"
        ],
        "properties": {
          "text": {
            "type": "string",
            "pattern": "^[^\\n\\r\\[\\]\\\\]*$"
          },
          "quote_id": {
            "type": "string",
            "enum": [
              "signature-file:0",
              "constructor:0"
            ]
          },
          "covers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "signature"
              ]
            }
          },
          "kind": {
            "type": "string",
            "enum": [
              "behavior",
              "limitation"
            ]
          }
        }
      }
    }
  }
}
