    "findings": [
      "\ub77c\ubca8 \uc124\uba85\uc744 \uac04\uc120\uc758 \ube44\ubb34\uc870\uac74 `condition_ref`\uc5d0 \ud55c\uc815\ud574\uc57c \ud569\ub2c8\ub2e4. \uc0dd\uc131\uae30\ub294 `always`\uc5d0\ub294 \uc870\uac74\uc744 \ub367\ubd99\uc774\uc9c0 \uc54a\uc73c\uba70, \uc870\uac74\uc744 \uc9c1\uc811 \ubcf5\uc0ac\ud55c \ub77c\ubca8\uc5d0\ub3c4 \uc120\ud0dd\ud55c `condition_ref`\uc758 \uc870\uac74\uc744 \ubcc4\ub3c4\ub85c \ub367\ubd99\uc785\ub2c8\ub2e4. \ube44\uad50 \uae30\ud638 \uac80\uc0ac\ub294 \ub178\ub4dc\uc640 \uac04\uc120\uc758 \ud55c\uad6d\uc5b4\u00b7\uc601\uc5b4 \ub77c\ubca8 \ubaa8\ub450\uc5d0 \uc801\uc6a9\ub429\ub2c8\ub2e4.",
      "\uac8c\uc2dc \uc911\ub2e8 \uc870\uac74\uc774 \ub108\ubb34 \ud3ec\uad04\uc801\uc785\ub2c8\ub2e4. \uc9c0\ubb38\uc740 \uc120\ud0dd\ub41c \uc18c\uc2a4\uc758 \ud30c\uc77c\u00b7\ud589\u00b7\ud574\uc2dc\u00b7\uc120\ud0dd\uc790\uc640 \uacc4\ud68d, \uc815\ucc45, \uc81c\ud55c \ubc0f \uc9c0\uc815\ub41c \uc5d0\uc774\uc804\ud2b8 \uc124\uc815\uc744 \uace0\uc815\ud569\ub2c8\ub2e4. \ubcf8\ubb38 \ubb34\uacb0\uc131 \uac80\uc0ac\ub294 \uc591\ub05d \uacf5\ubc31\uc744 \uc81c\uac70\ud55c \ubcf8\ubb38\uc758 \ud574\uc2dc\ub97c \ube44\uad50\ud558\ubbc0\ub85c \uc591\ub05d \uacf5\ubc31\ub9cc \ubc14\ub010 \uacbd\uc6b0\uc5d0\ub294 \uc911\ub2e8\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.",
      "\ub9c8\uc9c0\ub9c9 \ubb38\uc7a5\uc758 \u2018\uc0ac\ub78c\uc758 \uc2b9\uc778\u2019\uc744 \uc5b8\uae09\ud558\uba74 \uc218\ub3d9 \uc2b9\uc778\uc774 \ud544\uc694\ud55c \uac83\uc73c\ub85c \uc77d\ud790 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \uac80\uc0ac\ub294 \uc790\ub3d9 \ud3c9\uac00\uc774\uba70 \uc758\ubbf8\uc801 \ud0c0\ub2f9\uc131\uc744 \ubcf4\uc7a5\ud558\uc9c0 \uc54a\ub294\ub2e4\uace0 \uc124\uba85\ud558\uba74 \ub429\ub2c8\ub2e4."
    ],
    "scope": "\uc81c\uacf5\ub41c \uad6c\ud604\uc744 \uae30\uc900\uc73c\ub85c \uc0c8 `while_conditions` \uc870\uac01\uc758 \uae30\ubcf8\uac12, \uc9c0\uc6d0 \uc870\uac74, \uc124\uc815 \ud0c0\uc785, \uc18c\uc2a4 \uacb0\ud569 \ubc0f \uc7ac\uc0dd\uc131\u00b7\uac8c\uc2dc \uac80\uc0ac\ub97c \uac80\ud1a0\ud588\uc2b5\ub2c8\ub2e4. \uae30\uc874 \ubb38\uc11c\uc640 \ub2e4\uc774\uc5b4\uadf8\ub7a8\uc740 \uac80\ud1a0\ud558\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4."
  },
