    "findings": [
      "`while_conditions`\uc5d0\ub294 YAML \ubd88\ub9ac\uc5b8 `true` \ub610\ub294 `false`\ub9cc \ud5c8\uc6a9\ub41c\ub2e4\ub294 \uc810\uc744 \uba85\uc2dc\ud574\uc57c \ud55c\ub2e4. \ubb38\uc790\uc5f4, \uc22b\uc790, null\uc740 \uac70\ubd80\ub41c\ub2e4.",
