    },
    {
      "id": "end",
      "shape": "box",
      "label": "대응된 이벤트의 순서와 지연을 공통 시계에서 계산해 기록한다.",
      "label_en": "Record the ordering and delay of matched events calculated on the shared clock.",
      "evidence": [
